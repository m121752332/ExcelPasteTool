<?xml version="1.0" encoding="utf-8"?>
<!--
  osx-arm64 發佈設定：Visual Studio「發佈」與 packaging/publish.sh（GitHub Actions）共用這一份，只在這裡改。
  命令列：dotnet publish src/ExcelPasteTool -c Release -p:PublishProfile=osx-arm64
-->
<Project>
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <TargetFramework>net11.0</TargetFramework>
    <RuntimeIdentifier>osx-arm64</RuntimeIdentifier>
    <!-- 自包含 .NET 11 runtime，使用者免安裝 .NET（release.yml 會檢查） -->
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <!-- 預先編譯成原生碼，啟動約快 0.3 秒；PR 試打包會用 -p:PublishReadyToRun=false 關掉以省時間 -->
    <PublishReadyToRun>true</PublishReadyToRun>
    <!-- Avalonia 的 XAML 與 JSON 設定都靠反射，不裁剪 -->
    <PublishTrimmed>false</PublishTrimmed>
    <!-- 發佈檔不需要 .pdb，也省下產生時間 -->
    <DebugType>none</DebugType>
    <!-- 輸出到倉庫根目錄的 artifacts/osx-arm64/（已在 .gitignore）；publish.sh 會用 -o 另外指定 -->
    <PublishDir>$(MSBuildThisFileDirectory)..\..\..\..\artifacts\osx-arm64\</PublishDir>
  </PropertyGroup>
</Project>

<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net11.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationIcon>Assets\Logos\tiptop.ico</ApplicationIcon>
    <GenerateDocumentationFile>False</GenerateDocumentationFile>
	<RuntimeIdentifiers>win-x64;osx-x64;osx-arm64;linux-x64</RuntimeIdentifiers>
	  <AssemblyName>DataSplitter</AssemblyName>
	  <!-- AssemblyInfo 資訊 -->
	  <AssemblyTitle>DataSplitter Pro</AssemblyTitle>
	  <AssemblyDescription>一個幫助EXCEL做資料處理的分隔工具</AssemblyDescription>
	  <AssemblyCompany>GameStudioPro</AssemblyCompany>
	  <Product>DataSplitter Pro</Product>
	  <Copyright>GameStudio@2026</Copyright>
	  <!-- 版本號：推版時 tag 請用相同版本（1.1.0 或 v1.1.0），自動更新會拿它和 GitHub Release 比較 -->
	  <Version>1.7.1</Version>
	  <AssemblyVersion>1.7.1.0</AssemblyVersion>
	  <FileVersion>1.7.1.0</FileVersion>
	  <InformationalVersion>1.7.1</InformationalVersion>
	  <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>

	  <!-- 使用自動生成 (預設) -->
	  <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
  </PropertyGroup>

  <!-- 發佈參數（自包含、單一檔案、ReadyToRun 等）集中在 Properties/PublishProfiles/<rid>.pubxml，
       Visual Studio「發佈」與 packaging/publish.sh 共用同一份 -->
	
  <!-- 讓測試專案（倉庫根目錄的 tests/）讀得到 internal 成員 -->
  <ItemGroup>
    <InternalsVisibleTo Include="ExcelPasteTool.Tests" />
    <InternalsVisibleTo Include="ExcelPasteTool.UITests" />
  </ItemGroup>

  <ItemGroup>
	<PackageReference Include="Avalonia" />
	<PackageReference Include="Avalonia.Desktop" />
	<PackageReference Include="Avalonia.Controls.DataGrid" />
	<PackageReference Include="Avalonia.Themes.Fluent" />
	<PackageReference Include="Avalonia.Controls.WebView" />
  </ItemGroup>

  <ItemGroup>
    <AvaloniaResource Include="Resources\Languages\*.json" />
    <!-- 改版資訊：新增版本時在 Changelog.json 最前面加一筆即可 -->
    <AvaloniaResource Include="Resources\Changelog.json" />
  </ItemGroup>
	
  <ItemGroup>
    <!-- 內建字型（預設字型）：只放一般與粗體兩種字重，控制執行檔大小 -->
    <AvaloniaResource Include="Assets\Fonts\NotoSansTC-Regular.ttf" />
    <AvaloniaResource Include="Assets\Fonts\NotoSansTC-Bold.ttf" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Assets\Logos\tiptop.ico" />
  </ItemGroup>

  <ItemGroup>
    <Compile Update="Properties\Resources.Designer.cs">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>Resources.resx</DependentUpon>
    </Compile>
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Update="Properties\Resources.resx">
      <Generator>ResXFileCodeGenerator</Generator>
      <LastGenOutput>Resources.Designer.cs</LastGenOutput>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets/Images/*.png" />
    <!-- 使用說明（F1）：共用樣式 help.css ＋ 各語言一份內容 -->
    <AvaloniaResource Include="Assets/Help/*" />
  </ItemGroup>

</Project>
<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!--
    全 App 共用樣式。
    顏色一律使用 DynamicResource 取自 Assets/Themes/*Palette.axaml（由 ThemeManager 切換），
    字型與字體大小取自 AppFontFamily / AppFontSize*（由 FontManager 依設定寫入）。
    新增主題只要再加一份 Palette，不需要複製這份樣式。
  -->

  <!-- ===== 全域 ===== -->
  <Style Selector="Window">
    <Setter Property="Background" Value="{DynamicResource WindowBackgroundBrush}"/>
    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
    <Setter Property="FontFamily" Value="{DynamicResource AppFontFamily}"/>
    <Setter Property="FontSize" Value="{DynamicResource AppFontSize}"/>
  </Style>

  <!-- 注意：不要對所有 TextBlock 設定 Foreground，否則按鈕 hover 時文字無法跟著變色；
       一般文字顏色由 Window.Foreground 繼承。 -->

  <Style Selector="TextBlock.muted">
    <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
    <Setter Property="FontSize" Value="{DynamicResource AppFontSizeSmall}"/>
  </Style>

  <Style Selector="Path">
    <Setter Property="Fill" Value="{DynamicResource AccentTextBrush}"/>
  </Style>

  <!-- 按鈕內圖示顏色：依按鈕種類指定（Path 不會繼承 Foreground） -->
  <Style Selector="Button.primary Path">
    <Setter Property="Fill" Value="{DynamicResource TextOnAccentBrush}"/>
  </Style>
  <Style Selector="Button.copy-button Path">
    <Setter Property="Fill" Value="{DynamicResource CopyButtonForegroundBrush}"/>
  </Style>
  <Style Selector="Button.secondary Path">
    <Setter Property="Fill" Value="{DynamicResource DangerBrush}"/>
  </Style>
  <Style Selector="Button.secondary:pointerover Path, Button.secondary:pressed Path">
    <Setter Property="Fill" Value="White"/>
  </Style>

  <!-- ===== 面板 ===== -->
  <Style Selector="Border.panel">
    <Setter Property="Background" Value="{DynamicResource PanelBackgroundBrush}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource PanelBorderBrush}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="CornerRadius" Value="8"/>
    <Setter Property="BoxShadow" Value="0 1 3 0 #1F000000"/>
  </Style>

  <Style Selector="TextBlock.section-title">
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="FontSize" Value="{DynamicResource AppFontSizeLarge}"/>
    <Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}"/>
  </Style>

  <Style Selector="TextBlock.page-title">
    <Setter Property="FontWeight" Value="Bold"/>
    <Setter Property="FontSize" Value="{DynamicResource AppFontSizeTitle}"/>
    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
  </Style>

  <Style Selector="TextBlock.field-label">
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
  </Style>

  <!-- 數量徽章 -->
  <Style Selector="Border.badge">
    <Setter Property="Background" Value="{DynamicResource ControlHoverBrush}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource ControlBorderBrush}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="CornerRadius" Value="10"/>
    <Setter Property="Padding" Value="8,1"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
  </Style>
  <Style Selector="Border.badge TextBlock">
    <Setter Property="FontSize" Value="{DynamicResource AppFontSizeSmall}"/>
    <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
  </Style>

  <!-- 按鈕右上角的數量角標（工具列精簡模式時「重複項」的重複數） -->
  <Style Selector="Border.corner-badge">
    <Setter Property="Background" Value="{DynamicResource DangerBrush}"/>
    <Setter Property="CornerRadius" Value="8"/>
    <Setter Property="MinWidth" Value="16"/>
    <Setter Property="Height" Value="16"/>
    <Setter Property="Padding" Value="4,0"/>
  </Style>
  <Style Selector="Border.corner-badge TextBlock">
    <Setter Property="FontSize" Value="10"/>
    <Setter Property="FontWeight" Value="Bold"/>
    <Setter Property="Foreground" Value="White"/>
    <Setter Property="HorizontalAlignment" Value="Center"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
  </Style>

  <!-- ===== 輸入區 ===== -->
  <Style Selector="TextBox.input">
    <Setter Property="FontFamily" Value="{DynamicResource AppFontFamily}"/>
    <Setter Property="FontSize" Value="{DynamicResource AppFontSize}"/>
    <Setter Property="Background" Value="{DynamicResource InputBackgroundBrush}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource InputBorderBrush}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="CornerRadius" Value="6"/>
    <Setter Property="Padding" Value="10,8"/>
    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
    <Setter Property="CaretBrush" Value="{DynamicResource AccentTextBrush}"/>
    <Setter Property="SelectionBrush" Value="{DynamicResource SelectionBrush}"/>
    <Setter Property="SelectionForegroundBrush" Value="{DynamicResource SelectionTextBrush}"/>
    <Setter Property="TextWrapping" Value="Wrap"/>
    <Setter Property="AcceptsReturn" Value="True"/>
    <Setter Property="VerticalContentAlignment" Value="Top"/>
    <Setter Property="HorizontalAlignment" Value="Stretch"/>
    <Setter Property="VerticalAlignment" Value="Stretch"/>
    <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
    <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto"/>
  </Style>
  <!-- 蓋掉 Fluent 預設的 hover / focus 底色，讓三個主題一致 -->
  <Style Selector="TextBox.input:pointerover /template/ Border#PART_BorderElement">
    <Setter Property="Background" Value="{DynamicResource InputBackgroundBrush}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource InputFocusBorderBrush}"/>
  </Style>
  <Style Selector="TextBox.input:focus /template/ Border#PART_BorderElement">
    <Setter Property="Background" Value="{DynamicResource InputBackgroundBrush}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource InputFocusBorderBrush}"/>
    <Setter Property="BorderThickness" Value="1"/>
  </Style>
  <Style Selector="TextBox.input:pointerover">
    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
  </Style>
  <Style Selector="TextBox.input:focus">
    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
  </Style>
  <Style Selector="TextBox.input /template/ TextBlock#PART_Placeholder">
    <Setter Property="Foreground" Value="{DynamicResource EmptyStateBrush}"/>
  </Style>
  <Style Selector="TextBox.sql-output, TextBox.sql-output:pointerover, TextBox.sql-output:focus">
    <Setter Property="Foreground" Value="{DynamicResource SqlOutputBrush}"/>
  </Style>

  <!-- ===== 按鈕 ===== -->
  <Style Selector="Button.primary">
    <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
    <Setter Property="Foreground" Value="{DynamicResource TextOnAccentBrush}"/>
    <Setter Property="CornerRadius" Value="6"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="Padding" Value="14,7"/>
  </Style>
  <Style Selector="Button.primary:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource AccentHoverBrush}"/>
    <Setter Property="Foreground" Value="{DynamicResource TextOnAccentBrush}"/>
  </Style>
  <Style Selector="Button.primary:pressed /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource AccentPressedBrush}"/>
    <Setter Property="Foreground" Value="{DynamicResource TextOnAccentBrush}"/>
  </Style>

  <Style Selector="Button.secondary">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="Foreground" Value="{DynamicResource DangerBrush}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource DangerBrush}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="CornerRadius" Value="6"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="Padding" Value="12,6"/>
  </Style>
  <!-- 只顯示圖示的按鈕（工具列精簡模式），左右內距縮小 -->
  <Style Selector="Button.secondary.icon-only">
    <Setter Property="Padding" Value="9,6"/>
  </Style>
  <Style Selector="Button.secondary:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource DangerBrush}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource DangerBrush}"/>
    <Setter Property="Foreground" Value="White"/>
  </Style>
  <Style Selector="Button.secondary:pressed /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource DangerHoverBrush}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource DangerHoverBrush}"/>
    <Setter Property="Foreground" Value="White"/>
  </Style>

  <!-- 中性按鈕（例如「重複項」）：不具破壞性的次要操作用中性色，紅色只留給「清空資料」這類破壞性操作 -->
  <Style Selector="Button.neutral">
    <Setter Property="Background" Value="{DynamicResource ControlBackgroundBrush}"/>
    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource ControlBorderBrush}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="CornerRadius" Value="6"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="Padding" Value="12,6"/>
  </Style>
  <Style Selector="Button.neutral.icon-only">
    <Setter Property="Padding" Value="9,6"/>
  </Style>
  <Style Selector="Button.neutral:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource ControlHoverBrush}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource InputFocusBorderBrush}"/>
    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
  </Style>
  <Style Selector="Button.neutral:disabled /template/ ContentPresenter">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="BorderBrush" Value="{DynamicResource ControlBorderBrush}"/>
  </Style>
  <Style Selector="Button.neutral:disabled">
    <Setter Property="Opacity" Value="0.55"/>
  </Style>

  <Style Selector="Button.ghost">
    <Setter Property="Background" Value="{DynamicResource ControlBackgroundBrush}"/>
    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource ControlBorderBrush}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="CornerRadius" Value="6"/>
    <Setter Property="Padding" Value="10,5"/>
  </Style>
  <Style Selector="Button.ghost:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource ControlHoverBrush}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource InputFocusBorderBrush}"/>
    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
  </Style>

  <Style Selector="Button.copy-button">
    <Setter Property="Background" Value="{DynamicResource CopyButtonBackgroundBrush}"/>
    <Setter Property="Foreground" Value="{DynamicResource CopyButtonForegroundBrush}"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="CornerRadius" Value="6"/>
    <Setter Property="Width" Value="28"/>
    <Setter Property="Height" Value="28"/>
    <Setter Property="Padding" Value="0"/>
    <Setter Property="HorizontalContentAlignment" Value="Center"/>
    <Setter Property="VerticalContentAlignment" Value="Center"/>
  </Style>
  <Style Selector="Button.copy-button:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource CopyButtonHoverBrush}"/>
    <Setter Property="Foreground" Value="{DynamicResource CopyButtonForegroundBrush}"/>
  </Style>

  <!-- ===== 下拉選單 ===== -->
  <Style Selector="ComboBox">
    <Setter Property="Background" Value="{DynamicResource ControlBackgroundBrush}"/>
    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource ControlBorderBrush}"/>
    <Setter Property="CornerRadius" Value="6"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
  </Style>
  <Style Selector="ComboBox:pointerover /template/ Border#Background">
    <Setter Property="Background" Value="{DynamicResource ControlHoverBrush}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource InputFocusBorderBrush}"/>
  </Style>

  <!-- ===== 表格 ===== -->
  <Style Selector="Border.table-container">
    <Setter Property="Background" Value="{DynamicResource TableOddRowBrush}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource TableGridLineBrush}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="CornerRadius" Value="6"/>
    <Setter Property="ClipToBounds" Value="True"/>
  </Style>
  <Style Selector="Grid.data-table-header">
    <Setter Property="Background" Value="{DynamicResource TableHeaderBackgroundBrush}"/>
  </Style>
  <Style Selector="TextBlock.data-table-header">
    <Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}"/>
    <Setter Property="FontWeight" Value="Bold"/>
  </Style>
  <Style Selector="Border.grid-cell">
    <Setter Property="BorderBrush" Value="{DynamicResource TableGridLineBrush}"/>
  </Style>
  <Style Selector="Grid.data-row">
    <Setter Property="Background" Value="{DynamicResource TableOddRowBrush}"/>
  </Style>
  <Style Selector="Grid.data-row.even">
    <Setter Property="Background" Value="{DynamicResource TableEvenRowBrush}"/>
  </Style>
  <Style Selector="Grid.data-row:pointerover">
    <Setter Property="Background" Value="{DynamicResource TableRowHoverBrush}"/>
  </Style>
  <!-- 選取的列（按 Insert 會在它下面插入）：底色加深、行號改強調色 -->
  <Style Selector="Grid.data-row.selected">
    <Setter Property="Background" Value="{DynamicResource ControlHoverBrush}"/>
  </Style>
  <!-- 表格底部的「新增一筆」列 -->
  <Style Selector="Button.add-row">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource TableGridLineBrush}"/>
    <Setter Property="BorderThickness" Value="0,1,0,0"/>
    <Setter Property="CornerRadius" Value="0"/>
    <Setter Property="HorizontalAlignment" Value="Stretch"/>
    <Setter Property="HorizontalContentAlignment" Value="Left"/>
    <Setter Property="Padding" Value="22,7"/>
    <Setter Property="MinHeight" Value="34"/>
  </Style>
  <Style Selector="Button.add-row Path">
    <Setter Property="Fill" Value="{DynamicResource TextSecondaryBrush}"/>
  </Style>
  <Style Selector="Button.add-row:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource TableRowHoverBrush}"/>
    <Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}"/>
  </Style>
  <Style Selector="Button.add-row:pointerover Path">
    <Setter Property="Fill" Value="{DynamicResource AccentTextBrush}"/>
  </Style>
  <!-- 資料列的移除按鈕：滑鼠移到該列才顯示 -->
  <Style Selector="Button.row-remove">
    <Setter Property="Opacity" Value="0"/>
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="CornerRadius" Value="4"/>
    <Setter Property="Width" Value="22"/>
    <Setter Property="Height" Value="22"/>
    <Setter Property="Padding" Value="0"/>
    <Setter Property="HorizontalContentAlignment" Value="Center"/>
    <Setter Property="VerticalContentAlignment" Value="Center"/>
  </Style>
  <Style Selector="Grid.data-row:pointerover Button.row-remove">
    <Setter Property="Opacity" Value="1"/>
  </Style>
  <Style Selector="Button.row-remove Path">
    <Setter Property="Fill" Value="{DynamicResource DangerBrush}"/>
  </Style>
  <Style Selector="Button.row-remove:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource DangerBrush}"/>
  </Style>
  <Style Selector="Button.row-remove:pressed /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource DangerHoverBrush}"/>
  </Style>
  <Style Selector="Button.row-remove:pointerover Path, Button.row-remove:pressed Path">
    <Setter Property="Fill" Value="White"/>
  </Style>
  <Style Selector="TextBlock.row-number">
    <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
    <Setter Property="FontSize" Value="{DynamicResource AppFontSizeSmall}"/>
  </Style>
  <!-- 資料表直接編輯的輸入框 -->
  <Style Selector="TextBox.cell-editor">
    <Setter Property="Background" Value="{DynamicResource InputBackgroundBrush}"/>
    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource InputFocusBorderBrush}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="CornerRadius" Value="4"/>
    <Setter Property="Padding" Value="6,3"/>
    <Setter Property="MinHeight" Value="26"/>
    <Setter Property="CaretBrush" Value="{DynamicResource AccentTextBrush}"/>
    <Setter Property="SelectionBrush" Value="{DynamicResource SelectionBrush}"/>
    <Setter Property="SelectionForegroundBrush" Value="{DynamicResource SelectionTextBrush}"/>
    <Setter Property="AcceptsReturn" Value="False"/>
    <Setter Property="TextWrapping" Value="NoWrap"/>
    <Setter Property="VerticalContentAlignment" Value="Center"/>
  </Style>
  <Style Selector="TextBox.cell-editor:focus /template/ Border#PART_BorderElement">
    <Setter Property="Background" Value="{DynamicResource InputBackgroundBrush}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource InputFocusBorderBrush}"/>
  </Style>
  <Style Selector="TextBlock.row-data">
    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
    <Setter Property="TextWrapping" Value="Wrap"/>
  </Style>
  <Style Selector="TextBlock.empty-state">
    <Setter Property="Foreground" Value="{DynamicResource EmptyStateBrush}"/>
    <Setter Property="TextAlignment" Value="Center"/>
    <Setter Property="TextWrapping" Value="Wrap"/>
  </Style>

  <!-- 分隔線：參照 VS Code，中間放三個點點的握把，提示可以拖拉。
       點點用各主題既有的 TextSecondaryBrush / AccentTextBrush，新增主題不用另外定義顏色 -->
  <Style Selector="GridSplitter">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="Template">
      <ControlTemplate>
        <Border Background="{TemplateBinding Background}" CornerRadius="3">
          <StackPanel Name="PART_Grip" Spacing="3" IsHitTestVisible="False"
                      HorizontalAlignment="Center" VerticalAlignment="Center">
            <Ellipse Classes="splitter-dot"/>
            <Ellipse Classes="splitter-dot"/>
            <Ellipse Classes="splitter-dot"/>
          </StackPanel>
        </Border>
      </ControlTemplate>
    </Setter>
  </Style>
  <Style Selector="GridSplitter[ResizeDirection=Rows] /template/ StackPanel#PART_Grip">
    <Setter Property="Orientation" Value="Horizontal"/>
  </Style>
  <Style Selector="GridSplitter /template/ Ellipse.splitter-dot">
    <Setter Property="Width" Value="3"/>
    <Setter Property="Height" Value="3"/>
    <Setter Property="Fill" Value="{DynamicResource TextSecondaryBrush}"/>
    <Setter Property="Opacity" Value="0.7"/>
  </Style>
  <Style Selector="GridSplitter:pointerover">
    <Setter Property="Background" Value="{DynamicResource SplitterBrush}"/>
  </Style>
  <Style Selector="GridSplitter:pointerover /template/ Ellipse.splitter-dot">
    <Setter Property="Fill" Value="{DynamicResource AccentTextBrush}"/>
    <Setter Property="Opacity" Value="1"/>
  </Style>

  <!-- ===== 側邊欄 ===== -->
  <Style Selector="Border#SidebarBorder">
    <Setter Property="Background" Value="{DynamicResource SidebarBackgroundBrush}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource PanelBorderBrush}"/>
    <Setter Property="BorderThickness" Value="0,0,1,0"/>
  </Style>
  <Style Selector="Border#SidebarBorder TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource SidebarTextBrush}"/>
  </Style>
  <Style Selector="Border#SidebarBorder Path.sidebar-icon">
    <Setter Property="Fill" Value="{DynamicResource SidebarIconBrush}"/>
  </Style>
  <Style Selector="Button.sidebar-toggle">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="BorderThickness" Value="0"/>
  </Style>
  <Style Selector="Button.sidebar-toggle:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource SidebarHoverBrush}"/>
  </Style>
  <Style Selector="Button.sidebar-toggle Path">
    <Setter Property="Stroke" Value="{DynamicResource SidebarIconBrush}"/>
    <!-- 只畫線框：蓋掉全域 Path 的 Fill，否則封閉圖形會被填成一整塊強調色 -->
    <Setter Property="Fill" Value="Transparent"/>
  </Style>
  <Style Selector="Border.sidebar-item">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="CornerRadius" Value="8"/>
  </Style>
  <Style Selector="Border.sidebar-item:pointerover">
    <Setter Property="Background" Value="{DynamicResource SidebarHoverBrush}"/>
  </Style>
  <Style Selector="Border.sidebar-item.selected">
    <Setter Property="Background" Value="{DynamicResource SidebarSelectedBrush}"/>
  </Style>
  <Style Selector="Border.sidebar-indicator">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="CornerRadius" Value="2"/>
  </Style>
  <Style Selector="Border.sidebar-indicator.selected">
    <Setter Property="Background" Value="{DynamicResource SidebarIndicatorBrush}"/>
  </Style>
  <Style Selector="Button.sidebar-button">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="Padding" Value="0"/>
    <Setter Property="HorizontalAlignment" Value="Stretch"/>
    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
  </Style>
  <Style Selector="Button.sidebar-button:pointerover /template/ ContentPresenter, Button.sidebar-button:pressed /template/ ContentPresenter">
    <Setter Property="Background" Value="Transparent"/>
  </Style>

  <!-- ===== 設定頁 ===== -->
  <Style Selector="Border.setting-card">
    <Setter Property="Background" Value="{DynamicResource PanelBackgroundBrush}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource PanelBorderBrush}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="CornerRadius" Value="8"/>
    <Setter Property="Padding" Value="24,18"/>
  </Style>
  <Style Selector="Border.font-preview">
    <Setter Property="Background" Value="{DynamicResource InputBackgroundBrush}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource InputBorderBrush}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="CornerRadius" Value="6"/>
    <Setter Property="Padding" Value="14,10"/>
  </Style>

  <!-- 設定頁三層式（Win11 風格）：第 2 層分類卡片用 Button.setting-nav，第 3 層參數列用 Border.setting-row。
       一律左圖示、中間標題與說明、右邊控制項；顏色全部取自主題配色。 -->
  <Style Selector="Border.setting-row">
    <Setter Property="Background" Value="{DynamicResource PanelBackgroundBrush}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource PanelBorderBrush}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="CornerRadius" Value="6"/>
    <Setter Property="Padding" Value="16,12"/>
    <Setter Property="MinHeight" Value="68"/>
  </Style>
  <Style Selector="Border.setting-row-detail">
    <Setter Property="Background" Value="{DynamicResource InputBackgroundBrush}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource PanelBorderBrush}"/>
    <Setter Property="BorderThickness" Value="1,0,1,1"/>
    <Setter Property="CornerRadius" Value="0,0,6,6"/>
    <Setter Property="Padding" Value="56,14,16,16"/>
  </Style>
  <!-- 可收合群組卡片（同 Win11 設定 › 個人化 › 工作列）：標題列用 Button.setting-nav，展開後的內容用 setting-group-body，
       裡面每一列是縮排的 setting-subrow，列與列之間一條分隔線 -->
  <Style Selector="Border.setting-group-body">
    <Setter Property="Background" Value="{DynamicResource PanelBackgroundBrush}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource PanelBorderBrush}"/>
    <Setter Property="BorderThickness" Value="1,0,1,1"/>
    <Setter Property="CornerRadius" Value="0,0,6,6"/>
  </Style>
  <Style Selector="Border.setting-subrow">
    <Setter Property="BorderBrush" Value="{DynamicResource PanelBorderBrush}"/>
    <Setter Property="BorderThickness" Value="0,1,0,0"/>
    <Setter Property="Padding" Value="56,10,16,10"/>
    <Setter Property="MinHeight" Value="58"/>
  </Style>
  <Style Selector="TextBlock.setting-subtitle">
    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
    <Setter Property="TextWrapping" Value="Wrap"/>
  </Style>
  <Style Selector="Button.setting-nav">
    <Setter Property="Background" Value="{DynamicResource PanelBackgroundBrush}"/>
    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource PanelBorderBrush}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="CornerRadius" Value="6"/>
    <Setter Property="Padding" Value="16,12"/>
    <Setter Property="MinHeight" Value="68"/>
    <Setter Property="HorizontalAlignment" Value="Stretch"/>
    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
    <Setter Property="VerticalContentAlignment" Value="Center"/>
  </Style>
  <Style Selector="Button.setting-nav.expanded">
    <Setter Property="CornerRadius" Value="6,6,0,0"/>
  </Style>
  <Style Selector="Button.setting-nav:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource TableRowHoverBrush}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource ControlBorderBrush}"/>
    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
  </Style>
  <Style Selector="Button.setting-nav:pressed /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource ControlBackgroundBrush}"/>
    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
  </Style>
  <Style Selector="Path.setting-icon">
    <Setter Property="Fill" Value="{DynamicResource TextPrimaryBrush}"/>
    <Setter Property="Width" Value="20"/>
    <Setter Property="Height" Value="20"/>
    <Setter Property="Stretch" Value="Uniform"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
    <Setter Property="HorizontalAlignment" Value="Left"/>
  </Style>
  <!-- 只畫線的箭頭（›、⌄、⌃）：蓋掉全域 Path 的 Fill，避免被填成三角形 -->
  <Style Selector="Path.setting-chevron">
    <Setter Property="Fill" Value="Transparent"/>
    <Setter Property="Stroke" Value="{DynamicResource TextSecondaryBrush}"/>
    <Setter Property="StrokeThickness" Value="1.5"/>
    <Setter Property="StrokeLineCap" Value="Round"/>
    <Setter Property="StrokeJoin" Value="Round"/>
    <Setter Property="Width" Value="12"/>
    <Setter Property="Height" Value="12"/>
    <Setter Property="Stretch" Value="Uniform"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
  </Style>
  <Style Selector="TextBlock.setting-title">
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
    <Setter Property="TextWrapping" Value="Wrap"/>
  </Style>
  <Style Selector="TextBlock.setting-desc">
    <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
    <Setter Property="FontSize" Value="{DynamicResource AppFontSizeSmall}"/>
    <Setter Property="TextWrapping" Value="Wrap"/>
  </Style>
  <!-- 麵包屑「設定 ›」：外觀是大標題，可以點回設定首頁 -->
  <Style Selector="Button.breadcrumb">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="Padding" Value="0"/>
    <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
    <Setter Property="FontSize" Value="{DynamicResource AppFontSizeTitle}"/>
    <Setter Property="FontWeight" Value="Bold"/>
    <Setter Property="Cursor" Value="Hand"/>
  </Style>
  <Style Selector="Button.breadcrumb:pointerover /template/ ContentPresenter, Button.breadcrumb:pressed /template/ ContentPresenter">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
  </Style>

  <!-- 關於頁的版本按鈕：外觀維持漸層膠囊，滑過時稍微變亮 -->
  <Style Selector="Button.version-badge">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="Padding" Value="0"/>
    <Setter Property="Cursor" Value="Hand"/>
  </Style>
  <Style Selector="Button.version-badge:pointerover /template/ ContentPresenter, Button.version-badge:pressed /template/ ContentPresenter">
    <Setter Property="Background" Value="Transparent"/>
  </Style>
  <Style Selector="Button.version-badge:pointerover Border.version-pill">
    <Setter Property="Opacity" Value="0.85"/>
    <Setter Property="BoxShadow" Value="0 2 8 0 #4D000000"/>
  </Style>

  <!-- ===== 截圖管理 ===== -->
  <!-- 清單：透明底，選取 / 滑過時用主題的中性色（不用 Fluent 預設的系統強調色），圓角同設定頁 -->
  <Style Selector="ListBox.screenshot-list">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
  </Style>
  <Style Selector="ListBox.screenshot-list ListBoxItem">
    <Setter Property="Padding" Value="8"/>
    <Setter Property="Margin" Value="0,1"/>
    <Setter Property="CornerRadius" Value="6"/>
    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
  </Style>
  <Style Selector="ListBox.screenshot-list ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource TableRowHoverBrush}"/>
    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
  </Style>
  <Style Selector="ListBox.screenshot-list ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter, ListBox.screenshot-list ListBoxItem:selected:pointerover /template/ ContentPresenter#PART_ContentPresenter, ListBox.screenshot-list ListBoxItem:selected:focus /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource ControlHoverBrush}"/>
    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
  </Style>
  <!-- 月份資料夾列的展開箭頭：收合時朝右，展開時轉 90 度朝下 -->
  <Style Selector="Button.month-toggle">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="CornerRadius" Value="4"/>
  </Style>
  <Style Selector="Button.month-toggle:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource ControlHoverBrush}"/>
  </Style>
  <Style Selector="Path.month-chevron">
    <Setter Property="RenderTransform" Value="rotate(0deg)"/>
  </Style>
  <Style Selector="Path.month-chevron.expanded">
    <Setter Property="RenderTransform" Value="rotate(90deg)"/>
  </Style>
  <Style Selector="Border.screenshot-thumb">
    <Setter Property="Background" Value="{DynamicResource InputBackgroundBrush}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource PanelBorderBrush}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="CornerRadius" Value="4"/>
    <Setter Property="ClipToBounds" Value="True"/>
  </Style>
  <Style Selector="Border.screenshot-preview">
    <Setter Property="Background" Value="{DynamicResource InputBackgroundBrush}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource PanelBorderBrush}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="CornerRadius" Value="6"/>
    <Setter Property="Padding" Value="8"/>
    <Setter Property="ClipToBounds" Value="True"/>
  </Style>

  <!-- ===== App 導覽 ===== -->
  <!-- 右上角「導覽」按鈕 -->
  <Style Selector="Button.tour-button">
    <Setter Property="Background" Value="{DynamicResource ControlBackgroundBrush}"/>
    <Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource ControlBorderBrush}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="CornerRadius" Value="16"/>
    <Setter Property="Padding" Value="12,5"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
  </Style>
  <Style Selector="Button.tour-button:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource ControlHoverBrush}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource InputFocusBorderBrush}"/>
    <Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}"/>
  </Style>
  <!-- 目前步驟的外框 -->
  <Style Selector="Border.tour-ring">
    <Setter Property="BorderBrush" Value="{DynamicResource InputFocusBorderBrush}"/>
    <Setter Property="BorderThickness" Value="2"/>
    <Setter Property="CornerRadius" Value="8"/>
  </Style>
  <!-- 說明卡片 -->
  <Style Selector="Border.tour-card">
    <Setter Property="Background" Value="{DynamicResource PanelBackgroundBrush}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource PanelBorderBrush}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="CornerRadius" Value="10"/>
    <Setter Property="Padding" Value="20,16"/>
    <Setter Property="BoxShadow" Value="0 8 28 0 #66000000"/>
  </Style>
  <Style Selector="TextBlock.tour-step">
    <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
    <Setter Property="FontSize" Value="{DynamicResource AppFontSizeSmall}"/>
  </Style>
  <Style Selector="TextBlock.tour-title">
    <Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}"/>
    <Setter Property="FontSize" Value="{DynamicResource AppFontSizeLarge}"/>
    <Setter Property="FontWeight" Value="Bold"/>
  </Style>
  <Style Selector="TextBlock.tour-body">
    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
    <Setter Property="LineHeight" Value="22"/>
  </Style>
  <Style Selector="Button.tour-link">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="Padding" Value="2,5"/>
    <Setter Property="FontSize" Value="{DynamicResource AppFontSizeSmall}"/>
  </Style>
  <Style Selector="Button.tour-link:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
  </Style>
  <Style Selector="ProgressBar.tour-progress">
    <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
    <Setter Property="Background" Value="{DynamicResource ControlBorderBrush}"/>
    <Setter Property="CornerRadius" Value="2"/>
  </Style>

  <!-- ===== 精簡標題列（設定頁「精簡標題列」） ===== -->
  <Style Selector="Grid.compact-titlebar">
    <Setter Property="Background" Value="{DynamicResource SidebarBackgroundBrush}"/>
  </Style>
  <Style Selector="Button.titlebar-sidebar">
    <Setter Property="CornerRadius" Value="0"/>
    <Setter Property="Padding" Value="0"/>
  </Style>
  <Style Selector="Button.titlebar-button">
    <Setter Property="Width" Value="46"/>
    <Setter Property="Height" Value="36"/>
    <Setter Property="Padding" Value="0"/>
    <Setter Property="CornerRadius" Value="0"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="HorizontalContentAlignment" Value="Center"/>
    <Setter Property="VerticalContentAlignment" Value="Center"/>
  </Style>
  <Style Selector="Button.titlebar-button Path">
    <!-- 只畫線條：蓋掉全域 Path 的 Fill -->
    <Setter Property="Fill" Value="Transparent"/>
    <Setter Property="Stroke" Value="{DynamicResource TextPrimaryBrush}"/>
    <Setter Property="StrokeThickness" Value="1"/>
  </Style>
  <Style Selector="Button.titlebar-button:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource ControlHoverBrush}"/>
  </Style>
  <Style Selector="Button.titlebar-close:pointerover /template/ ContentPresenter, Button.titlebar-close:pressed /template/ ContentPresenter">
    <Setter Property="Background" Value="#E81123"/>
  </Style>
  <Style Selector="Button.titlebar-close:pointerover Path, Button.titlebar-close:pressed Path">
    <Setter Property="Stroke" Value="White"/>
  </Style>

  <!-- ===== Toast 通知（參照 UniGetUI，卡片由 Helpers/ToastQueueHelper.cs 建立） ===== -->
  <Style Selector="Border.toast">
    <Setter Property="Background" Value="{DynamicResource ToastBackgroundBrush}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource ToastBorderBrush}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="CornerRadius" Value="8"/>
    <Setter Property="ClipToBounds" Value="True"/>
    <Setter Property="BoxShadow" Value="0 8 24 0 #3D000000"/>
    <Setter Property="Cursor" Value="Arrow"/>
  </Style>
  <Style Selector="Border.toast TextBlock.toast-text">
    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
    <Setter Property="FontWeight" Value="Normal"/>
    <Setter Property="TextWrapping" Value="Wrap"/>
  </Style>
  <!-- 依種類淡淡染色的底層 -->
  <Style Selector="Border.toast Border.toast-tint">
    <Setter Property="Background" Value="{DynamicResource AccentTextBrush}"/>
    <Setter Property="Opacity" Value="0.08"/>
  </Style>
  <Style Selector="Border.toast.success Border.toast-tint">
    <Setter Property="Background" Value="{DynamicResource SuccessBrush}"/>
  </Style>
  <Style Selector="Border.toast.warning Border.toast-tint">
    <Setter Property="Background" Value="{DynamicResource WarningBrush}"/>
  </Style>
  <Style Selector="Border.toast.error Border.toast-tint">
    <Setter Property="Background" Value="{DynamicResource DangerBrush}"/>
  </Style>
  <Style Selector="Border.toast Border.toast-strip">
    <Setter Property="Background" Value="{DynamicResource AccentTextBrush}"/>
  </Style>
  <Style Selector="Border.toast Path.toast-icon">
    <Setter Property="Fill" Value="{DynamicResource AccentTextBrush}"/>
  </Style>
  <Style Selector="Border.toast.success Border.toast-strip">
    <Setter Property="Background" Value="{DynamicResource SuccessBrush}"/>
  </Style>
  <Style Selector="Border.toast.success Path.toast-icon">
    <Setter Property="Fill" Value="{DynamicResource SuccessBrush}"/>
  </Style>
  <Style Selector="Border.toast.warning Border.toast-strip">
    <Setter Property="Background" Value="{DynamicResource WarningBrush}"/>
  </Style>
  <Style Selector="Border.toast.warning Path.toast-icon">
    <Setter Property="Fill" Value="{DynamicResource WarningBrush}"/>
  </Style>
  <Style Selector="Border.toast.error Border.toast-strip">
    <Setter Property="Background" Value="{DynamicResource DangerBrush}"/>
  </Style>
  <Style Selector="Border.toast.error Path.toast-icon">
    <Setter Property="Fill" Value="{DynamicResource DangerBrush}"/>
  </Style>
  <Style Selector="Button.toast-close">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="CornerRadius" Value="4"/>
    <Setter Property="Width" Value="28"/>
    <Setter Property="Height" Value="28"/>
    <Setter Property="Padding" Value="0"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="Opacity" Value="0.7"/>
    <Setter Property="HorizontalContentAlignment" Value="Center"/>
    <Setter Property="VerticalContentAlignment" Value="Center"/>
  </Style>
  <Style Selector="Button.toast-close Path">
    <Setter Property="Fill" Value="{DynamicResource TextSecondaryBrush}"/>
  </Style>
  <Style Selector="Button.toast-close:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource ControlHoverBrush}"/>
  </Style>
  <Style Selector="Button.toast-close:pointerover">
    <Setter Property="Opacity" Value="1"/>
  </Style>

  <!-- ===== SQL 格式選項 ===== -->
  <!-- 浮出式選單的外框交給內層 Border.sql-options 畫，FlyoutPresenter 本身透明、不留內距 -->
  <Style Selector="FlyoutPresenter.sql-options-flyout">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="Padding" Value="0"/>
    <Setter Property="CornerRadius" Value="8"/>
    <Setter Property="MaxWidth" Value="400"/>
  </Style>
  <Style Selector="Border.sql-options">
    <Setter Property="Background" Value="{DynamicResource ToastBackgroundBrush}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource ToastBorderBrush}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="CornerRadius" Value="8"/>
    <Setter Property="Padding" Value="14,12"/>
    <Setter Property="Margin" Value="0,4,0,0"/>
    <Setter Property="BoxShadow" Value="0 6 18 0 #40000000"/>
  </Style>
  <Style Selector="TextBlock.sql-warning">
    <Setter Property="Foreground" Value="{DynamicResource WarningBrush}"/>
    <Setter Property="FontSize" Value="{DynamicResource AppFontSizeSmall}"/>
    <Setter Property="TextWrapping" Value="Wrap"/>
  </Style>
  <Style Selector="Button.copy-button.active">
    <Setter Property="Background" Value="{DynamicResource CopyButtonHoverBrush}"/>
  </Style>
  <Style Selector="Button.copy-button.active Path">
    <Setter Property="Fill" Value="{DynamicResource AccentTextBrush}"/>
  </Style>
  <!-- 選取列的行號（要放在 TextBlock.row-number 之後才蓋得過） -->
  <Style Selector="Grid.data-row.selected TextBlock.row-number">
    <Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}"/>
    <Setter Property="FontWeight" Value="Bold"/>
  </Style>
</Styles>

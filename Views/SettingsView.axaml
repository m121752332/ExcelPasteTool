<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="ExcelPasteTool.SettingsView">
    <Grid>
        <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="32,24" Spacing="12" Width="720" HorizontalAlignment="Left">
                <TextBlock Text="{Binding TitleText.Text}" Classes="page-title" Margin="0,0,0,4"/>

                <!-- 語言 -->
                <Border Classes="setting-card">
                    <StackPanel Spacing="6">
                        <TextBlock Text="{Binding LanguageTitleText.Text}" Classes="section-title"/>
                        <TextBlock Text="{Binding LanguageDescText.Text}" Classes="muted" Margin="0,0,0,6"/>
                        <ComboBox Width="320"
                                  ItemsSource="{Binding Languages, Mode=OneWay}"
                                  SelectedItem="{Binding SelectedLanguage, Mode=TwoWay}"/>
                    </StackPanel>
                </Border>

                <!-- 主題 -->
                <Border Classes="setting-card">
                    <StackPanel Spacing="6">
                        <TextBlock Text="{Binding ThemeTitleText.Text}" Classes="section-title"/>
                        <TextBlock Text="{Binding ThemeDescText.Text}" Classes="muted" Margin="0,0,0,6"/>
                        <ComboBox Width="320"
                                  ItemsSource="{Binding Themes, Mode=OneWay}"
                                  SelectedItem="{Binding SelectedTheme, Mode=TwoWay}"/>
                    </StackPanel>
                </Border>

                <!-- 字型 -->
                <Border Classes="setting-card">
                    <StackPanel Spacing="6">
                        <TextBlock Text="{Binding FontTitleText.Text}" Classes="section-title"/>
                        <TextBlock Text="{Binding FontDescText.Text}" Classes="muted" Margin="0,0,0,6"/>
                        <ComboBox Width="320" MaxDropDownHeight="360"
                                  ItemsSource="{Binding FontFamilies, Mode=OneWay}"
                                  SelectedItem="{Binding SelectedFontFamily, Mode=TwoWay}"/>
                    </StackPanel>
                </Border>

                <!-- 字體大小 -->
                <Border Classes="setting-card">
                    <StackPanel Spacing="6">
                        <TextBlock Text="{Binding FontSizeTitleText.Text}" Classes="section-title"/>
                        <TextBlock Text="{Binding FontSizeDescText.Text}" Classes="muted" Margin="0,0,0,6"/>
                        <Grid ColumnDefinitions="Auto,*,Auto,Auto" Margin="0,0,0,4">
                            <Button Grid.Column="0" Name="DecreaseFontButton" Classes="ghost" Content="A−" Width="44" HorizontalContentAlignment="Center"/>
                            <Slider Grid.Column="1" Margin="12,0" VerticalAlignment="Center"
                                    Minimum="{Binding MinFontSize}" Maximum="{Binding MaxFontSize}"
                                    TickFrequency="1" IsSnapToTickEnabled="True" SmallChange="1" LargeChange="2"
                                    Value="{Binding FontSize, Mode=TwoWay}"/>
                            <Button Grid.Column="2" Name="IncreaseFontButton" Classes="ghost" Content="A+" Width="44" HorizontalContentAlignment="Center"/>
                            <TextBlock Grid.Column="3" Text="{Binding FontSizeDisplay}" Width="60" TextAlignment="Right"
                                       VerticalAlignment="Center" FontWeight="SemiBold"/>
                        </Grid>
                        <Border Classes="font-preview">
                            <TextBlock Text="{Binding FontPreviewText.Text}" TextWrapping="Wrap"/>
                        </Border>
                        <Button Name="ResetFontButton" Classes="ghost" Content="{Binding FontResetText.Text}" Margin="0,6,0,0"/>
                    </StackPanel>
                </Border>

                <!-- 說明開啟方式 -->
                <Border Classes="setting-card">
                    <StackPanel Spacing="6">
                        <TextBlock Text="{Binding HelpViewerTitleText.Text}" Classes="section-title"/>
                        <TextBlock Text="{Binding HelpViewerDescText.Text}" Classes="muted" Margin="0,0,0,6" TextWrapping="Wrap"/>
                        <ComboBox Width="320"
                                  ItemsSource="{Binding HelpViewers, Mode=OneWay}"
                                  SelectedItem="{Binding SelectedHelpViewer, Mode=TwoWay}"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>

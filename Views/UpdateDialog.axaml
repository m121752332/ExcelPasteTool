<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="ExcelPasteTool.UpdateDialog"
        Title="軟體更新"
        Width="520" SizeToContent="Height"
        MinHeight="220" MaxHeight="640"
        CanResize="False"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">

	<Grid RowDefinitions="Auto,Auto,Auto,Auto" Margin="24" RowSpacing="16">

		<!-- 標題區 -->
		<Grid Grid.Row="0" ColumnDefinitions="Auto,*" ColumnSpacing="16">
			<Border x:Name="IconBadge" Width="52" Height="52" CornerRadius="26" VerticalAlignment="Top">
				<Border.Background>
					<LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
						<GradientStop Color="#0ABAB5" Offset="0"/>
						<GradientStop Color="#3B82F6" Offset="1"/>
					</LinearGradientBrush>
				</Border.Background>
				<TextBlock x:Name="IconText" Text="⬆" FontSize="24" Foreground="White"
						   HorizontalAlignment="Center" VerticalAlignment="Center"/>
			</Border>
			<StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
				<TextBlock x:Name="TitleText" Text="發現新版本" FontSize="20" FontWeight="Bold" TextWrapping="Wrap"/>
				<TextBlock x:Name="SubtitleText" Text="" FontSize="13" Opacity="0.75" TextWrapping="Wrap"/>
			</StackPanel>
		</Grid>

		<!-- 更新內容 -->
		<Border Grid.Row="1" x:Name="NotesPanel" CornerRadius="8" Padding="14,12"
				BorderThickness="1" BorderBrush="#33808080" Background="#11808080">
			<StackPanel Spacing="6">
				<TextBlock Text="更新內容" FontWeight="SemiBold" FontSize="13"/>
				<ScrollViewer MaxHeight="220" HorizontalScrollBarVisibility="Disabled">
					<SelectableTextBlock x:Name="NotesText" TextWrapping="Wrap" FontSize="13" LineHeight="20"/>
				</ScrollViewer>
			</StackPanel>
		</Border>

		<!-- 進度 -->
		<StackPanel Grid.Row="2" x:Name="ProgressPanel" Spacing="8" IsVisible="False">
			<ProgressBar x:Name="DownloadProgressBar" Minimum="0" Maximum="100" Height="8" CornerRadius="4"
						 Foreground="#0ABAB5"/>
			<Grid ColumnDefinitions="*,Auto">
				<TextBlock x:Name="StatusText" Text="" FontSize="12" Opacity="0.8" TextWrapping="Wrap"/>
				<TextBlock Grid.Column="1" x:Name="PercentText" Text="" FontSize="12" FontWeight="SemiBold" Margin="12,0,0,0"/>
			</Grid>
		</StackPanel>

		<!-- 按鈕 -->
		<StackPanel Grid.Row="3" Orientation="Horizontal" Spacing="10" HorizontalAlignment="Right">
			<Button x:Name="SecondaryButton" Content="稍後再說" MinWidth="96"
					HorizontalContentAlignment="Center" Click="SecondaryButton_Click"/>
			<Button x:Name="PrimaryButton" Content="立即更新" MinWidth="110"
					HorizontalContentAlignment="Center" Click="PrimaryButton_Click"
					Background="#0ABAB5" Foreground="White" FontWeight="SemiBold"/>
		</StackPanel>
	</Grid>
</Window>

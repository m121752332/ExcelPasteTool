<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="ExcelPasteTool.ChangelogWindow"
        Title="改版資訊"
        Width="560" Height="560" MinWidth="420" MinHeight="320"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">

	<Grid RowDefinitions="Auto,*,Auto" Margin="20" RowSpacing="12">
		<TextBlock x:Name="HeaderText" Grid.Row="0" FontSize="20" FontWeight="Bold"/>

		<ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
			<StackPanel x:Name="VersionList" Spacing="8" Margin="0,0,12,0"/>
		</ScrollViewer>

		<Button x:Name="CloseButton" Grid.Row="2" MinWidth="96" HorizontalAlignment="Right"
				HorizontalContentAlignment="Center" Click="CloseButton_Click"/>
	</Grid>
</Window>

<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:ExcelPasteTool"
             x:Class="ExcelPasteTool.DataToolView">
	<Grid>
		<!-- Toast 通知 -->
		<Border Name="ToastPanel"
                Background="#E6222222"
                CornerRadius="8"
                Padding="18,10"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                Margin="0,24,24,0"
                IsVisible="False"
                ZIndex="1000">
			<TextBlock Name="ToastText" Foreground="#FFA726" FontWeight="Bold"/>
		</Border>

		<!-- 版面：上方工具列（Auto）＋ 下方內容（填滿剩餘高度），不再包外層 ScrollViewer，
		     讓左右面板與表格可以正確撐滿視窗，貼上大量資料時只有表格本身捲動 -->
		<Grid RowDefinitions="Auto,*" Margin="12">
			<!-- 頂部控制區域 -->
			<Border Grid.Row="0" Classes="panel" Padding="16,10" Margin="0,0,0,12">
				<WrapPanel Orientation="Horizontal" ItemSpacing="28" LineSpacing="8">
					<!-- 分隔符號 -->
					<StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
						<TextBlock Name="SeparatorLabel" Classes="field-label"/>
						<ComboBox Name="SeparatorComboBox" MinWidth="120" SelectedIndex="0"/>
					</StackPanel>
					<!-- 語言 -->
					<StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
						<Path Data="{x:Static local:IconManager.LanguageIcon}" Width="16" Height="16" Stretch="Uniform" VerticalAlignment="Center"/>
						<TextBlock Name="LanguageLabel" Classes="field-label"/>
						<ComboBox Name="LanguageSelector" MinWidth="120" SelectedIndex="0"/>
					</StackPanel>
					<!-- 主題 -->
					<StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
						<Path Data="{x:Static local:IconManager.ThemeIcon}" Width="16" Height="16" Stretch="Uniform" VerticalAlignment="Center"/>
						<TextBlock Name="ThemeLabel" Classes="field-label"/>
						<ComboBox Name="ThemeSelector" MinWidth="140" SelectedIndex="0"/>
					</StackPanel>
				</WrapPanel>
			</Border>

			<!-- 主要內容區域 -->
			<Grid Grid.Row="1" ColumnDefinitions="2*,12,3*">
				<!-- 左側：分隔資料 / SQL 條件 -->
				<Border Grid.Column="0" Classes="panel" Padding="16" MinWidth="280">
					<Grid RowDefinitions="Auto,*,Auto,*">
						<!-- PIP 分隔資料標題 -->
						<Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,8">
							<StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
								<Path Data="{x:Static local:IconManager.DataIcon}" Width="18" Height="18" Stretch="Uniform" VerticalAlignment="Center"/>
								<TextBlock Name="PipDataTitle" Classes="section-title" VerticalAlignment="Center"/>
							</StackPanel>
							<Button Name="CopyTopBoxButton" Classes="copy-button" Grid.Column="1" ToolTip.Tip="複製分隔資料">
								<Path Data="{x:Static local:IconManager.PasteIcon}" Width="15" Height="15" Stretch="Uniform"/>
							</Button>
						</Grid>
						<TextBox Grid.Row="1" Name="TopBox" Classes="input" MinHeight="90"/>

						<!-- SQL 條件標題 -->
						<Grid Grid.Row="2" ColumnDefinitions="*,Auto" Margin="0,16,0,8">
							<StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
								<Path Data="{x:Static local:IconManager.ContentIcon}" Width="18" Height="18" Stretch="Uniform" VerticalAlignment="Center"/>
								<TextBlock Name="SqlConditionTitle" Classes="section-title" VerticalAlignment="Center"/>
							</StackPanel>
							<Button Name="CopyBottomBoxButton" Classes="copy-button" Grid.Column="1" ToolTip.Tip="複製SQL條件">
								<Path Data="{x:Static local:IconManager.PasteIcon}" Width="15" Height="15" Stretch="Uniform"/>
							</Button>
						</Grid>
						<TextBox Grid.Row="3" Name="BottomBox" Classes="input sql-output" MinHeight="90" IsReadOnly="True"/>
					</Grid>
				</Border>

				<!-- Splitter：可拖曳調整左右寬度 -->
				<GridSplitter Grid.Column="1" ResizeDirection="Columns" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>

				<!-- 右側：資料表 -->
				<Border Grid.Column="2" Classes="panel" Padding="16" MinWidth="320">
					<Grid RowDefinitions="Auto,*">
						<!-- 按鈕列 -->
						<Grid Grid.Row="0" ColumnDefinitions="Auto,Auto,*,Auto" Margin="0,0,0,12">
							<Button Grid.Column="0" Name="PasteDataButton" Classes="primary" Cursor="Hand">
								<StackPanel Orientation="Horizontal" Spacing="6">
									<Path Data="{x:Static local:IconManager.PasteIcon}" Width="15" Height="15" Stretch="Uniform" VerticalAlignment="Center"/>
									<TextBlock Name="PasteButtonText" VerticalAlignment="Center"/>
								</StackPanel>
							</Button>
							<Border Grid.Column="1" Classes="badge" Margin="12,0,0,0">
								<TextBlock Name="RowCountText"/>
							</Border>
							<Button Grid.Column="3" Name="ClearDataButton" Classes="secondary" Cursor="Hand">
								<StackPanel Orientation="Horizontal" Spacing="6">
									<Path Data="{x:Static local:IconManager.ClearIcon}" Width="15" Height="15" Stretch="Uniform" VerticalAlignment="Center"/>
									<TextBlock Name="ClearButtonText" VerticalAlignment="Center"/>
								</StackPanel>
							</Button>
						</Grid>

						<!-- 資料表格：表頭固定，只有資料列捲動；關閉水平捲動讓長字串自動換行，表頭與資料列欄寬一致 -->
						<Border Grid.Row="1" Classes="table-container">
							<Grid RowDefinitions="Auto,*">
								<Grid Grid.Row="0" ColumnDefinitions="64,*" Classes="data-table-header" MinHeight="36">
									<Border Grid.Column="0" Classes="grid-cell" BorderThickness="0,0,1,1">
										<Button Name="CopyTableButton" Background="Transparent" BorderThickness="0" Padding="0" Cursor="Hand"
												HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
												HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
												ToolTip.Tip="複製全部資料" Click="CopyTableButton_Click">
											<TextBlock Name="RowNumberHeader" Classes="data-table-header"/>
										</Button>
									</Border>
									<Border Grid.Column="1" Classes="grid-cell" BorderThickness="0,0,0,1">
										<StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center" Margin="10,0">
											<Path Data="{x:Static local:IconManager.ContentIcon}" Width="14" Height="14" Stretch="Uniform" VerticalAlignment="Center"/>
											<TextBlock Name="DataContentHeader" Classes="data-table-header" VerticalAlignment="Center"/>
										</StackPanel>
									</Border>
								</Grid>

								<ScrollViewer Grid.Row="1" Name="TableScroll"
											  HorizontalScrollBarVisibility="Disabled"
											  VerticalScrollBarVisibility="Auto">
									<ItemsControl Name="DataRows" ItemsSource="{Binding DataItems}">
										<ItemsControl.ItemsPanel>
											<ItemsPanelTemplate>
												<VirtualizingStackPanel/>
											</ItemsPanelTemplate>
										</ItemsControl.ItemsPanel>
										<ItemsControl.ItemTemplate>
											<DataTemplate>
												<Grid Classes="data-row" Classes.even="{Binding IsEven}" ColumnDefinitions="64,*" MinHeight="30">
													<Border Grid.Column="0" Classes="grid-cell" BorderThickness="0,0,1,1">
														<TextBlock Text="{Binding RowNumber}" Classes="row-number" HorizontalAlignment="Center" VerticalAlignment="Center"/>
													</Border>
													<Border Grid.Column="1" Classes="grid-cell" BorderThickness="0,0,0,1">
														<SelectableTextBlock Text="{Binding Value}" Classes="row-data" Margin="10,5" VerticalAlignment="Center"
																			 Foreground="{DynamicResource TextPrimaryBrush}" TextWrapping="Wrap"
																			 SelectionBrush="{DynamicResource SelectionBrush}"/>
													</Border>
												</Grid>
											</DataTemplate>
										</ItemsControl.ItemTemplate>
									</ItemsControl>
								</ScrollViewer>

								<!-- 無資料提示 -->
								<TextBlock Grid.Row="1" Name="EmptyStateText" Classes="empty-state"
										   HorizontalAlignment="Center" VerticalAlignment="Center" Margin="24"/>
							</Grid>
						</Border>
					</Grid>
				</Border>
			</Grid>
		</Grid>
	</Grid>
</UserControl>

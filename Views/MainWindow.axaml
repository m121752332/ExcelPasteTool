<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ExcelPasteTool"
        mc:Ignorable="d" d:DesignWidth="1100" d:DesignHeight="700"
        x:Class="ExcelPasteTool.MainWindow"
        x:Name="MainWindowInstance"
        Width="1100" Height="700"
        MinWidth="900" MinHeight="560"
        WindowStartupLocation="CenterScreen">
	<Window.Resources>
		<local:SidebarWidthConverter x:Key="SidebarWidthConverter" />
		<local:SidebarExpandVisibilityConverter x:Key="SidebarExpandVisibilityConverter" />
		<local:SidebarPageToContentConverter x:Key="SidebarPageToContentConverter" />
	</Window.Resources>
	<!-- 最外層 Panel：主版面之上再疊「導覽」按鈕與導覽圖層 -->
	<Panel Name="RootPanel">
	<Grid RowDefinitions="Auto,*">
	<!-- 精簡標題列（設定頁「精簡標題列」開啟時才顯示，見 MainWindow.TitleBar.cs）：
	     只留側邊欄開關與最小化 / 最大化 / 關閉，其餘空白處可拖曳視窗、雙擊放大 -->
	<Grid Grid.Row="0" Name="CompactTitleBar" Classes="compact-titlebar" Height="36"
		  ColumnDefinitions="Auto,*,Auto,Auto,Auto" IsVisible="False">
		<Button Grid.Column="0" Name="TitleBarSidebarButton" Classes="sidebar-toggle titlebar-sidebar"
				Click="SidebarToggleButton_Click" Width="56" Height="36"
				HorizontalContentAlignment="Center" VerticalContentAlignment="Center">
			<Path Data="M8,6 H20 A3,3 0 0 1 23,9 V19 A3,3 0 0 1 20,22 H8 A3,3 0 0 1 5,19 V9 A3,3 0 0 1 8,6 Z M11.5,6 V22"
				  StrokeThickness="1.6" StrokeJoin="Round" Width="22" Height="22"/>
		</Button>
		<Border Grid.Column="1" Name="TitleBarDragArea" Background="Transparent"
				PointerPressed="TitleBarDragArea_PointerPressed"/>
		<Button Grid.Column="2" Name="MinimizeButton" Classes="titlebar-button" Click="MinimizeButton_Click">
			<Path Data="M0,5 H10" Width="10" Height="10"/>
		</Button>
		<Button Grid.Column="3" Name="MaximizeButton" Classes="titlebar-button" Click="MaximizeButton_Click">
			<Path Name="MaximizeIcon" Data="M0.5,0.5 H9.5 V9.5 H0.5 Z" Width="10" Height="10"/>
		</Button>
		<Button Grid.Column="4" Name="CloseButton" Classes="titlebar-button titlebar-close" Click="CloseButton_Click">
			<Path Data="M0,0 L10,10 M10,0 L0,10" Width="10" Height="10"/>
		</Button>
	</Grid>
	<Grid Grid.Row="1" ColumnDefinitions="Auto,*">
		<Border x:Name="SidebarBorder" Grid.Column="0"
				Width="{Binding Sidebar.IsExpanded, Converter={StaticResource SidebarWidthConverter}}">
			<StackPanel>
				<!-- 側邊欄切換鈕：圓角面板＋左側分隔線，點擊展開 / 收合側邊欄 -->
				<Button Name="SidebarToggleButton"
						Classes="sidebar-toggle"
						Click="SidebarToggleButton_Click"
						Height="48" Margin="4,8,4,8"
						HorizontalAlignment="Stretch"
						HorizontalContentAlignment="Center">
					<Path Data="M8,6 H20 A3,3 0 0 1 23,9 V19 A3,3 0 0 1 20,22 H8 A3,3 0 0 1 5,19 V9 A3,3 0 0 1 8,6 Z M11.5,6 V22"
						  StrokeThickness="1.6" StrokeJoin="Round"
						  Width="28" Height="28"/>
				</Button>
				<!-- 導覽按鈕 -->
				<ItemsControl ItemsSource="{Binding SidebarItems}">
					<ItemsControl.ItemTemplate>
						<DataTemplate>
							<Border Classes="sidebar-item" Classes.selected="{Binding IsSelected}" Margin="4,2">
								<Button Classes="sidebar-button"
										Command="{Binding DataContext.SidebarItemClickCommand, RelativeSource={RelativeSource AncestorType=Window}}"
										CommandParameter="{Binding Page}"
										Height="44"
										ToolTip.Tip="{Binding ToolTipText}">
									<Grid ColumnDefinitions="4,40,*">
										<!-- 選取導引條 -->
										<Border Grid.Column="0" Classes="sidebar-indicator" Classes.selected="{Binding IsSelected}" Width="3" Height="22"/>
										<Path Grid.Column="1" Classes="sidebar-icon" Data="{Binding Icon}" Width="20" Height="20" Stretch="Uniform"
											  HorizontalAlignment="Center" VerticalAlignment="Center"/>
										<TextBlock Grid.Column="2" Text="{Binding Name}" Margin="4,0,0,0" VerticalAlignment="Center" FontWeight="SemiBold"
												   TextTrimming="CharacterEllipsis"
												   IsVisible="{Binding DataContext.Sidebar.IsExpanded, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource SidebarExpandVisibilityConverter}}"/>
									</Grid>
								</Button>
							</Border>
						</DataTemplate>
					</ItemsControl.ItemTemplate>
				</ItemsControl>
			</StackPanel>
		</Border>
		<ContentControl Grid.Column="1" x:Name="MainContent" Content="{Binding Sidebar.SelectedPage, Converter={StaticResource SidebarPageToContentConverter}}" />

		<!-- 右上角「導覽」按鈕：只在「工具」頁顯示（由 MainWindow.Tour.cs 控制），可隨時重看操作導覽 -->
		<Button Grid.Column="1" Name="TourButton" Classes="tour-button"
				HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,23,26,0"
				Cursor="Hand" Click="TourButton_Click">
			<StackPanel Orientation="Horizontal" Spacing="6">
				<Path Data="{x:Static local:IconManager.TourIcon}" Width="15" Height="15" Stretch="Uniform" VerticalAlignment="Center"/>
				<TextBlock Name="TourButtonText" VerticalAlignment="Center"/>
			</StackPanel>
		</Button>
	</Grid>
	</Grid>

	<!-- App 導覽圖層（第一次開啟自動播放） -->
	<local:TourOverlay Name="TourLayer"/>

	<!-- Toast 通知：全 App 共用一個，放在最上層（高於導覽按鈕與導覽遮罩），不攔截滑鼠 -->
	<Border Name="ToastPanel"
			Background="#E6222222"
			CornerRadius="8"
			Padding="18,10"
			HorizontalAlignment="Right"
			VerticalAlignment="Top"
			Margin="0,30,30,0"
			IsVisible="False"
			IsHitTestVisible="False"
			ZIndex="20000">
		<TextBlock Name="ToastText" Foreground="#FFA726" FontWeight="Bold"/>
	</Border>
	</Panel>
</Window>

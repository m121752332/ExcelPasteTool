<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <AvaloniaVersion>12.1.6</AvaloniaVersion>
  </PropertyGroup>

  <ItemGroup>
    <!-- 定義一組「Avalonia 家族」（與 Avalonia 本體同一個版本號發佈的套件） -->
    <AvaloniaPackages Include="Avalonia" />
    <AvaloniaPackages Include="Avalonia.Desktop" />
    <AvaloniaPackages Include="Avalonia.Themes.Fluent" />
    <AvaloniaPackages Include="Avalonia.Skia" />
    <AvaloniaPackages Include="Avalonia.Headless.XUnit" />

    <!-- 對整組一次指定版本 -->
    <PackageVersion Include="@(AvaloniaPackages)" Version="$(AvaloniaVersion)" />

    <!-- Avalonia 12 起 DataGrid 與 WebView 各自發版，版本號不跟 Avalonia 本體走 -->
    <PackageVersion Include="Avalonia.Controls.DataGrid" Version="12.1.2" />
    <!-- 說明頁用的原生 WebView（官方、MIT；Windows：WebView2、macOS：WKWebView、Linux：WebKitGTK） -->
    <PackageVersion Include="Avalonia.Controls.WebView" Version="12.1.2" />

    <!-- 單元測試（tests/ExcelPasteTool.Tests） -->
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.12.0" />
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="3.1.5" />
    <!-- UI 測試（tests/ExcelPasteTool.UITests）：Avalonia.Headless.XUnit 12 建立在 xUnit v3 上 -->
    <PackageVersion Include="xunit.v3" Version="3.2.2" />
    <!-- 端到端測試（tests/ExcelPasteTool.E2ETests）：用 FlaUI（UIA3）操作真實執行檔，只在 Windows 本機跑 -->
    <PackageVersion Include="FlaUI.Core" Version="5.0.0" />
    <PackageVersion Include="FlaUI.UIA3" Version="5.0.0" />
  </ItemGroup>
</Project>

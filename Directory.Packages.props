<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <AvaloniaVersion>11.3.3</AvaloniaVersion>
  </PropertyGroup>

  <ItemGroup>
    <!-- 定義一組「Avalonia 家族」 -->
    <AvaloniaPackages Include="Avalonia" />
    <AvaloniaPackages Include="Avalonia.Desktop" />
    <AvaloniaPackages Include="Avalonia.Controls.DataGrid" />
    <AvaloniaPackages Include="Avalonia.Themes.Fluent" />

    <!-- 對整組一次指定版本 -->
    <PackageVersion Include="@(AvaloniaPackages)" Version="$(AvaloniaVersion)" />

    <!-- 說明頁用的原生 WebView（官方、MIT；11.4.x 支援 Avalonia 11.1 以上） -->
    <PackageVersion Include="Avalonia.Controls.WebView" Version="11.4.1" />

    <PackageVersion Include="System.ComponentModel.Annotations" Version="5.0.0" />

    <!-- Avalonia 11.3.3 間接帶入的 Tmds.DBus.Protocol 0.21.2 有高風險弱點（GHSA-xrw6-gwf8-vvr9，只影響 Linux），
         直接鎖到已修正的 0.21.3。之後升級 Avalonia 若已內含更新版本，可以移除這行與 csproj 裡對應的參考 -->
    <PackageVersion Include="Tmds.DBus.Protocol" Version="0.21.3" />
  </ItemGroup>
</Project>

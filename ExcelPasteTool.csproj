<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationIcon>Assets\Logos\tiptop.ico</ApplicationIcon>
    <GenerateDocumentationFile>False</GenerateDocumentationFile>
	<RuntimeIdentifiers>win-x64;osx-x64;osx-arm64;linux-x64</RuntimeIdentifiers>
	  <AssemblyName>DataSplitter</AssemblyName>
	  <!-- AssemblyInfo 資訊 -->
	  <AssemblyTitle>DataSplitter Pro</AssemblyTitle>
	  <AssemblyDescription>一個幫助EXCEL做資料處理的分隔工具</AssemblyDescription>
	  <AssemblyCompany>GameStudioPro</AssemblyCompany>
	  <Product>DataSplitter Pro</Product>
	  <Copyright>GameStudio@2026</Copyright>
	  <!-- 版本號：推版時 tag 請用相同版本（1.1.0 或 v1.1.0），自動更新會拿它和 GitHub Release 比較 -->
	  <Version>1.4.1</Version>
	  <AssemblyVersion>1.4.1.0</AssemblyVersion>
	  <FileVersion>1.4.1.0</FileVersion>
	  <InformationalVersion>1.4.1</InformationalVersion>
	  <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>

	  <!-- 使用自動生成 (預設) -->
	  <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
  </PropertyGroup>

  <!-- 發行時預先編譯成原生碼（ReadyToRun），啟動時不必再 JIT，可縮短約 0.3 秒；代價是檔案變大 -->
  <PropertyGroup Condition="'$(RuntimeIdentifier)' != ''">
    <PublishReadyToRun>true</PublishReadyToRun>
  </PropertyGroup>
	
  <ItemGroup>
	<PackageReference Include="Avalonia" />
	<PackageReference Include="Avalonia.Desktop" />
	<PackageReference Include="Avalonia.Controls.DataGrid" />
	<PackageReference Include="Avalonia.Themes.Fluent" />
	<PackageReference Include="Avalonia.Controls.WebView" />
	<PackageReference Include="System.ComponentModel.Annotations" />
  </ItemGroup>

  <ItemGroup>
    <AvaloniaResource Include="Resources\Languages\*.json" />
  </ItemGroup>
	
  <ItemGroup>
    <!-- 內建字型（預設字型），其餘字重檔案未打包以控制執行檔大小 -->
    <AvaloniaResource Include="Assets\Fonts\NotoSansTC-Regular.ttf" />
    <AvaloniaResource Include="Assets\Fonts\NotoSansTC-Bold.ttf" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Assets\Logos\tiptop.ico" />
  </ItemGroup>

  <ItemGroup>
    <Compile Update="Properties\Resources.Designer.cs">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>Resources.resx</DependentUpon>
    </Compile>
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Update="Properties\Resources.resx">
      <Generator>ResXFileCodeGenerator</Generator>
      <LastGenOutput>Resources.Designer.cs</LastGenOutput>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup>
    <Folder Include="artifacts\linux-x64\" />
    <Folder Include="Controls\" />
  </ItemGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets/Images/*.png" />
    <!-- 使用說明（F1）：共用樣式 help.css ＋ 各語言一份內容 -->
    <AvaloniaResource Include="Assets/Help/*" />
  </ItemGroup>

</Project>